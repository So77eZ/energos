# SITE_ADDRESS: в проде — домен (energos.example), тогда Caddy сам получает сертификат
# Let's Encrypt и редиректит http → https. Без переменной — `:80`, только HTTP (локальная разработка).
{$SITE_ADDRESS::80} {
    @dev_api {
        expression `{env.DEPLOY_ENV} == "dev"`
        path /api /api/*
    }

    handle @dev_api {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
